;; Forward references and reused children form fixed-cost direct-call trees.
;; Effects make the original low-budget entry checkpoints observable.
(module
  (type $unary (func (param i32) (result i32)))
  (type $pair (func (param i32 i64) (result i64 i32)))
  (import "env" "observe" (func $observe (type $unary)))
  (import "env" "spend" (func $spend (type $unary)))
  (memory (export "memory") 1)
  (global $progress (export "progress") (mut i32) (i32.const 0))
  (table 2 funcref)
  (elem (i32.const 0) $leaf $effect_middle)
  (func (export "pair_tree") (type $pair)
    local.get 0 local.get 1 call $pair_middle)
  (func (export "stack_tree") (type $unary)
    i32.const 100 local.get 0 call $twice i32.add)
  (func (export "diamond_tree") (type $unary)
    local.get 0 call $double local.get 0 call $double i32.add)
  (func (export "effect_tree") (type $unary)
    local.get 0 call $effect_middle)
  (func (export "effect_table") (type $unary)
    local.get 0 i32.const 1 call_indirect (type $unary))
  (func (export "tree_if") (type $unary)
    local.get 0 if (result i32)
      i32.const 7 call $effect_middle
    else i32.const 9 call $effect_middle end)
  (func (export "tree_loop") (type $unary) (local i32)
    block $out loop $again
      local.get 1 local.get 0 i32.ge_u br_if $out
      i32.const 7 call $effect_middle drop
      local.get 1 i32.const 1 i32.add local.set 1 br $again
    end end local.get 1)
  (func (export "trap_tree") (type $unary)
    local.get 0 call $trap_middle)
  (func (export "host_tree") (type $unary)
    local.get 0 call $host_middle)
  (func (export "spend_tree") (type $unary)
    local.get 0 call $spend_middle)
  (func (export "indirect_tree") (type $unary)
    local.get 0 call $indirect_middle)
  (func (export "cycle_tree") call $cycle_a)
  (func (export "loop_tree") call $loop_middle)
  (func (export "trap_checkpoint_tree") (param i32)
    local.get 0 call $trap_checkpoint_middle)
  ;; Preserve a live value below a void call on both paths.
  (func (export "void_tree") (result i32)
    i32.const 17 call $void_middle)
  (func $pair_middle (type $pair)
    local.get 0 local.get 1 call $pair_leaf)
  (func $pair_leaf (type $pair)
    local.get 1 local.get 0 i32.const 3 i32.add)
  (func $twice (type $unary) local.get 0 call $leaf call $leaf)
  (func $double (type $unary)
    local.get 0 call $leaf local.get 0 call $leaf i32.add)
  (func $leaf (type $unary) local.get 0 i32.const 1 i32.add)
  (func $effect_middle (export "effect_middle") (type $unary)
    local.get 0 call $effect_leaf call $effect_leaf)
  (func $effect_leaf (type $unary)
    global.get $progress i32.const 1 i32.add global.set $progress
    i32.const 0 local.get 0 i32.store local.get 0)
  (func $trap_middle (type $unary)
    local.get 0 call $effect_leaf local.get 0 i32.div_u)
  (func $host_middle (type $unary) local.get 0 call $observe)
  (func $spend_middle (type $unary) local.get 0 call $spend)
  (func $indirect_middle (type $unary)
    local.get 0 i32.const 0 call_indirect (type $unary))
  (func $cycle_a call $cycle_b)
  (func $cycle_b call $cycle_a)
  (func $loop_middle loop $again br $again end)
  (func $trap_checkpoint_middle (param i32)
    local.get 0 call $effect_leaf drop unreachable)
  (func $void_middle call $void_leaf)
  (func $void_leaf nop)
)
